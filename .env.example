# ===========================================
# GrowthVerse — Environment Variables
# Copy this file to .env.local and fill in values
# ===========================================

# AI (Required — powers chat, reflection, exploration)
# At least one provider key is required. Configure multiple to allow user switching.
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GOOGLE_API_KEY=your_google_key_here
# QWEN_API_KEY=your_qwen_key_here        # 通义千问 (DashScope)
# DEEPSEEK_API_KEY=your_deepseek_key_here
# ZHIPU_API_KEY=your_zhipu_key_here      # 智谱 GLM

# Supabase (optional/reserved)
# Current exploration, reflection, and settings data is stored in localStorage.
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# External APIs (optional)
GOOGLE_BOOKS_API_KEY=your_google_books_key_here

# Douban Book API (local service, see douban-book-api/ directory)
DOUBAN_API_URL=http://localhost:3900

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
